OPENAI_API_KEY=
# Neon/PostgreSQL connection string. Required in production.
DATABASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=45000
OPENAI_IMAGE_MODEL=gpt-image-1
# Admin username is fixed as `admin`; set a strong password (12+ chars).
ADMIN_PASSWORD=
# Generate at least 32 random bytes for signing the HttpOnly admin session.
SESSION_SECRET=
# Exactly 32 random bytes, as 64 hex characters; used for AES-256-GCM encryption.
MASTER_KEY=
PORT=8080
